# Публічна адреса сайту (canonical, OG, sitemap).
NEXT_PUBLIC_SITE_URL="https://zadovbalo.example"

# Класифікатор текстів. Зараз реалізовано лише "mock" (локальні правила, без зовнішніх запитів).
# Реальний провайдер підключається через src/lib/ai/providers — ключ тільки серверний, без NEXT_PUBLIC_.
AI_PROVIDER="mock"
# AI_API_KEY=""
AI_TIMEOUT_MS="12000"

# Голосовий ввід: "browser" (Web Speech API) або "server" (запис → /api/transcribe).
NEXT_PUBLIC_SPEECH_PROVIDER="browser"
# Серверне розпізнавання ще не підключене; /api/transcribe відповідає 501, доки не задано провайдера.
# SPEECH_PROVIDER=""
# SPEECH_API_KEY=""
