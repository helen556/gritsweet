# ── Сайт ────────────────────────────────────────────────────────────
# Реальний домен (canonical, Open Graph, sitemap). Без слеша в кінці.
NEXT_PUBLIC_SITE_URL="https://example.com"
# Код підтвердження Google Search Console (мета-тег). Брати з GSC, не вигадувати.
GOOGLE_SITE_VERIFICATION=""

# ── Cloudflare Workers AI (лише сервер; без префікса NEXT_PUBLIC_) ───
# Account ID — 32 hex-символи.
CLOUDFLARE_ACCOUNT_ID=""
# Новий API-токен (дашборд → Workers AI → REST API → «Create a Workers AI API Token»: права Workers AI Read + Edit).
# Вставляти лише в .env.local і в налаштування хостингу. Не в чат, не в код, не в логи.
CLOUDFLARE_API_TOKEN=""
# Модель із підтримкою JSON Mode. За замовчуванням — @cf/meta/llama-3.3-70b-instruct-fp8-fast.
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# "cloudflare" (типово) або "off", щоб вимкнути AI й лишити тільки ручний вибір.
AI_PROVIDER="cloudflare"
# Таймаут запиту до моделі, мс (1000–30000).
AI_TIMEOUT_MS="9000"

# ── Ліміти й бюджет (спільні між serverless-інстансами) ─────────────
# Upstash Redis REST або Vercel KV. Без них у продакшені AI вимикається (лишається ручний вибір).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL / KV_REST_API_TOKEN — те саме від інтеграції Vercel KV (можна будь-яку пару).
# Сіль для хешу IP у ключах лімітів (будь-який випадковий рядок).
RATE_LIMIT_SALT=""
# Запитів до AI на хвилину й на добу з одного клієнта; загальний добовий бюджет запитів.
AI_RATE_PER_MINUTE="6"
AI_RATE_PER_DAY="40"
AI_DAILY_REQUEST_LIMIT="150"
# Лише для локальної перевірки продакшен-збірки без Upstash: дозволити ліміти в памʼяті одного процесу.
# ALLOW_INSTANCE_LOCAL_LIMITS="true"

# ── Голос ───────────────────────────────────────────────────────────
# "browser" (Web Speech API) або "server" (запис → /api/transcribe; потрібен SPEECH_PROVIDER).
NEXT_PUBLIC_SPEECH_PROVIDER="browser"
# SPEECH_PROVIDER=""
# SPEECH_API_KEY=""
