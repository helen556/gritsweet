# ---- Обов'язкові ----
# SQLite для розробки або PostgreSQL (Neon/Supabase) для production.
# На Vercel можна не задавати: при підключенні бази через Storage Vercel сам додає POSTGRES_URL — його теж підхоплено.
DATABASE_URL=file:./data/dev.db
# SSL для PostgreSQL: порожньо = з перевіркою сертифіката; no-verify — якщо пулер дає помилку сертифіката; off — лише локально
DATABASE_SSL=
# ≥ 32 випадкових символи: openssl rand -base64 32
SESSION_SECRET=
# Публічна адреса сайту (canonical, sitemap, посилання в листах і Telegram)
APP_URL=http://localhost:3000

# Перша власниця: створюється при `npm run db:setup` (і при збірці на Vercel), лише якщо адміністраторів ще немає.
# Пароль ≥ 12 символів, без «admin»/частини email. Після першого входу змініть пароль в адмінці й видаліть ці змінні.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- Оплата ----
# Режим обирається в адмінці (Налаштування → Оплата); ця змінна — лише значення за замовчуванням.
# disabled | manual_link | mono_acquiring | provider(тест, лише розробка)
#   manual_link    — оплата за посиланням (типово надане send.monobank), ручна перевірка адміністратором
#   mono_acquiring — рахунок monobank на кожне замовлення + підписаний вебхук (потрібен MONOBANK_TOKEN; НЕ перевірено наживо)
PAYMENT_MODE=
# Токен мерчанта monobank еквайрингу (X-Token) — лише сервер
MONOBANK_TOKEN=
# test — ЛИШЕ для розробки (у production ігнорується)
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ---- Email (лист із PDF-книжкою й квитанцією після оплати) ----
# none | gmail | smtp | resend | outbox (outbox — лише розробка: листи у storage/outbox)
EMAIL_PROVIDER=none
# gmail: адреса Gmail і ПАРОЛЬ ЗАСТОСУНКУ Google (myaccount.google.com → Безпека → Двоетапна перевірка → Паролі застосунків)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# smtp: будь-який поштовий сервер
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# resend: ключ і адреса відправника на підтвердженому в Resend домені
RESEND_API_KEY=
EMAIL_FROM=
# Ім'я відправника (необов'язково), за замовчуванням «Історії принцеси Лілі»
EMAIL_FROM_NAME=
DOWNLOAD_LINK_TTL_HOURS=72
DOWNLOAD_MAX_COUNT=5

# ---- Приватне сховище PDF ----
# local (тека на постійному диску) | supabase (приватний bucket)
PRIVATE_STORAGE=local
PRIVATE_STORAGE_DIR=storage/private
UPLOADS_DIR=storage/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=private-books

# ---- Нова пошта (необов'язково; без ключа — ручне введення) ----
NOVA_POSHTA_API_KEY=

# ---- Аналітика без персональних даних (необов'язково) ----
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ---- Meta Pixel (необов'язково; ID надає таргетологиня) ----
# Публічний ID пікселя (лише цифри). Задається ДО збірки (Vercel: змінна + Redeploy). Порожньо — піксель і банер згоди не показуються.
# Піксель завантажується лише після згоди відвідувача на рекламні cookie.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API (серверна подія Purchase після підтвердженої оплати, лише за згоди покупця). Токен — СЕКРЕТ, лише сервер.
META_CAPI_ACCESS_TOKEN=
# Необов'язково: код тестових подій з Events Manager (для перевірки) і версія Graph API (за замовчуванням v22.0)
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# ---- Telegram-сповіщення власниці (бот магазину) ----
# Лише серверні змінні/secret manager платформи. Не надсилати токен у чат, не класти в ZIP чи репозиторій.
TELEGRAM_BOT_TOKEN=
# chat_id: npm run telegram:chat-id (після /start у боті). Для групи — лише приватна група довірених людей.
TELEGRAM_CHAT_ID=

# ---- Cron (повтор сповіщень і листів): Vercel додає Authorization: Bearer $CRON_SECRET ----
CRON_SECRET=
